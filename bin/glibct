#!/data/data/com.termux/files/usr/bin/bash
# glibct: a Termux shell where every command runs with glibc.
# https://github.com/ssfuisu/glibct

GLIBCT_VERSION=1.1.0
TERMUX_PREFIX=/data/data/com.termux/files/usr
GLIBC_PREFIX=$TERMUX_PREFIX/glibc
GLIBC_BASH=$GLIBC_PREFIX/bin/bash
HOOK=$GLIBC_PREFIX/lib/libglibct.so
TERMUX_HOOK=$TERMUX_PREFIX/lib/libglibct-termux.so
PRELOAD_FILE=$GLIBC_PREFIX/etc/ld.so.preload
RCFILE=$TERMUX_PREFIX/share/glibct/bashrc
INSTALLER=https://raw.githubusercontent.com/ssfuisu/glibct/main/install.sh

usage() {
	cat <<EOF
Usage: glibct [COMMAND [ARGS...]]
       glibct -c STRING [ARGS...]

Without arguments, glibct opens a shell where every command runs with glibc.
Type 'exit' to go back to the normal Termux shell.

With a command, glibct runs only that command with glibc and exits.

Options:
  -c STRING      run STRING in the glibc shell
  --doctor       check that everything glibct needs is in place
  --update       update glibct to the newest version
  --uninstall    remove glibct (the glibc packages stay installed)
  -h, --help     show this help
  -V, --version  show the version
EOF
}

die() {
	printf 'glibct: %s\n' "$*" >&2
	exit 1
}

# The glibc loader reads $PRELOAD_FILE and loads the hook into every glibc
# program. Android's linker never reads that file.
hook_enabled() {
	local line
	[ -r "$PRELOAD_FILE" ] || return 1
	while IFS= read -r line || [ -n "$line" ]; do
		[ "$line" = "$HOOK" ] && return 0
	done <"$PRELOAD_FILE"
	return 1
}

enable_hook() {
	hook_enabled || printf '%s\n' "$HOOK" >>"$PRELOAD_FILE" ||
		die "cannot write $PRELOAD_FILE"
}

disable_hook() {
	local line keep=()
	[ -f "$PRELOAD_FILE" ] || return 0
	while IFS= read -r line || [ -n "$line" ]; do
		[ "$line" = "$HOOK" ] || keep+=("$line")
	done <"$PRELOAD_FILE"
	if [ ${#keep[@]} -eq 0 ]; then
		rm -f "$PRELOAD_FILE"
	else
		printf '%s\n' "${keep[@]}" >"$PRELOAD_FILE"
	fi
}

# Removes the Termux hook from LD_PRELOAD of the programs this script starts.
drop_termux_hook() {
	local IFS=: entry keep=() entries=()
	read -ra entries <<<"${LD_PRELOAD-}"
	for entry in "${entries[@]}"; do
		[ "$entry" = "$TERMUX_HOOK" ] || keep+=("$entry")
	done
	if [ ${#keep[@]} -eq 0 ]; then
		unset LD_PRELOAD
	else
		export LD_PRELOAD="${keep[*]}"
	fi
}

uninstall() {
	# A Termux program with a missing library in LD_PRELOAD does not start.
	drop_termux_hook
	# Disable first: a listed but missing hook makes glibc print a warning
	# for every program.
	disable_hook
	rm -f "$HOOK" "$TERMUX_HOOK" "$RCFILE" "$TERMUX_PREFIX/bin/glibct"
	rmdir "$TERMUX_PREFIX/share/glibct" 2>/dev/null
	echo "glibct is removed. The glibc packages are still installed."
	echo "Close the glibct shells that are still open with 'exit'."
}

update() {
	local tmp rc
	tmp=$(mktemp "$TERMUX_PREFIX/tmp/glibct-update.XXXXXX") || exit 1
	if ! curl -fsSL -o "$tmp" "$INSTALLER"; then
		rm -f "$tmp"
		die "cannot download the installer, check the internet connection"
	fi
	"$TERMUX_PREFIX/bin/bash" "$tmp"
	rc=$?
	rm -f "$tmp"
	exit "$rc"
}

# --doctor: one line per check, in words that need no knowledge of Linux.
doctor() {
	local problems=0 v
	ok() { printf '  ok       %s\n' "$1"; }
	note() { printf '  note     %s\n' "$1"; }
	problem() {
		printf '  PROBLEM  %s\n           Fix: %s\n' "$1" "$2"
		problems=$((problems + 1))
	}

	echo "glibct $GLIBCT_VERSION checkup"
	echo
	if [ "$(uname -m)" = aarch64 ]; then
		ok "64-bit ARM device (Android $(getprop ro.build.version.release 2>/dev/null))"
	else
		problem "this device is $(uname -m), glibct needs 64-bit ARM (aarch64)" \
			"none, glibct cannot work on this device"
	fi
	if [ -e "$GLIBC_PREFIX/lib/ld-linux-aarch64.so.1" ]; then
		v=$(env -u LD_PRELOAD "$GLIBC_PREFIX/bin/ldd" --version 2>/dev/null)
		v=${v%%$'\n'*}
		ok "glibc is installed (${v##* })"
	else
		problem "glibc is not installed" "pkg install glibc-repo && pkg install glibc"
	fi
	if [ -x "$GLIBC_BASH" ]; then
		ok "the glibc shell (bash-glibc) is installed"
	else
		problem "the glibc shell is not installed" "pkg install bash-glibc"
	fi
	if [ -x "$GLIBC_PREFIX/bin/ls" ]; then
		ok "the basic glibc tools (coreutils-glibc) are installed"
	else
		note "the basic glibc tools are not installed, Termux's are used: pkg install coreutils-glibc"
	fi
	if [ ! -f "$HOOK" ]; then
		problem "the glibct library is missing" "glibct --update"
	elif hook_enabled; then
		ok "the glibct library is installed and turned on"
	else
		enable_hook
		ok "the glibct library was turned off, it is turned on again"
	fi
	if [ -f "$TERMUX_HOOK" ]; then
		ok "the Termux helper library is installed"
	else
		problem "the Termux helper library is missing" "glibct --update"
	fi
	if [ -x "$GLIBC_BASH" ] && [ -f "$HOOK" ] && (
		setup_env
		# shellcheck disable=SC2016 # expanded by the glibc bash
		"$GLIBC_BASH" -c 'while read -r l; do
			case $l in *libglibct.so*) exit 0 ;; esac
		done </proc/self/maps; exit 1'
	); then
		ok "a test command ran with glibc and the glibct library"
	else
		problem "a test command did not run with glibc" "glibct --update"
	fi
	if [ -x "$GLIBC_PREFIX/bin/box64" ]; then
		ok "box64 is installed, programs for x86_64 PCs can run"
	else
		note "box64 is not installed, programs for x86_64 PCs cannot run: pkg install box64-glibc"
	fi
	echo
	if [ "$problems" -eq 0 ]; then
		echo "Everything glibct needs is in place."
	else
		echo "$problems problem(s) found, see the Fix lines above."
		return 1
	fi
}

check_install() {
	[ -x "$GLIBC_BASH" ] ||
		die "glibc bash is missing, install it with: pkg install bash-glibc"
	[ -f "$HOOK" ] || die "$HOOK is missing, please reinstall glibct"
	enable_hook
}

# PATH with $GLIBC_PREFIX/bin right before $TERMUX_PREFIX/bin, so glibc
# programs win over Termux programs of the same name.
glibc_path() {
	local IFS=: dir added='' out=() dirs=()
	read -ra dirs <<<"$PATH"
	for dir in "${dirs[@]}"; do
		[ "$dir" = "$GLIBC_PREFIX/bin" ] && continue
		if [ -z "$added" ] && [ "$dir" = "$TERMUX_PREFIX/bin" ]; then
			out+=("$GLIBC_PREFIX/bin")
			added=1
		fi
		out+=("$dir")
	done
	[ -n "$added" ] || out=("$GLIBC_PREFIX/bin" "${out[@]}")
	printf '%s' "${out[*]}"
}

setup_env() {
	# The hook gives Termux programs these values back. Keep the first
	# ones when glibct is started again from a program inside glibct.
	if [ "${GLIBCT-}" != 1 ]; then
		drop_termux_hook
		export GLIBCT_TERMUX_LD_PRELOAD="${LD_PRELOAD-}"
		export GLIBCT_TERMUX_SHELL="${SHELL-}"
		if [ -n "${LD_LIBRARY_PATH+set}" ]; then
			export GLIBCT_TERMUX_LD_LIBRARY_PATH="$LD_LIBRARY_PATH"
		else
			unset GLIBCT_TERMUX_LD_LIBRARY_PATH
		fi
	fi
	# Termux's LD_PRELOAD holds Android libraries; glibc cannot load them.
	unset LD_PRELOAD LD_LIBRARY_PATH
	PATH=$(glibc_path)
	export PATH
	export SHELL="$GLIBC_BASH"
	export GLIBCT=1
}

case "${1-}" in
-h | --help)
	usage
	exit 0
	;;
-V | --version)
	echo "glibct $GLIBCT_VERSION"
	exit 0
	;;
--uninstall)
	uninstall
	exit 0
	;;
--update)
	update
	;;
--doctor)
	doctor
	exit
	;;
-c)
	[ $# -ge 2 ] || die "-c needs a command string"
	;;
-*)
	die "unknown option '$1', see 'glibct --help'"
	;;
esac

check_install

if [ $# -eq 0 ]; then
	# A 'glibct' line in ~/.bashrc must not start a second shell while
	# the glibct shell reads ~/.bashrc.
	[ -n "${GLIBCT_STARTING-}" ] && exit 0
	setup_env
	exec -a glibct "$GLIBC_BASH" --rcfile "$RCFILE"
fi

setup_env
if [ "$1" = -c ]; then
	shift
	exec -a glibct "$GLIBC_BASH" -c "$@"
fi
# shellcheck disable=SC2016 # $@ is expanded by the glibc bash
exec -a glibct "$GLIBC_BASH" -c 'exec "$@"' glibct "$@"
